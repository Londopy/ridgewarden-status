[Unit]
Description=ridgewarden-status, a status page for AREDN meshes
Documentation=https://github.com/Londopy/ridgewarden-status
After=network-online.target ridgewarden.service
Wants=network-online.target

[Service]
# its own user, in the core's group: it can read the core's local.token, not its station key
User=ridgewarden-status
Group=ridgewarden-status
SupplementaryGroups=ridgewarden
ExecStart=/usr/bin/ridgewarden-status --config /etc/ridgewarden/status.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ridgewarden-status

[Install]
WantedBy=multi-user.target
